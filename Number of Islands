//Number of Islands

class Solution 
{
  public:
    int countIslands(vector<vector<char>>& Grid) 
    {
        int Islands = 0;
        
        queue<vector<int>> Q;
        vector<int> Temp;
        
        int M = Grid.size();
        int N = Grid[0].size();
        
        vector<vector<int>> Check (M, vector<int>(N, 0));
        
        for(int X = 0; X < M; X++)
        {
            for(int Y = 0; Y < N; Y++)
            {
                if(Grid[X][Y] == 'L' && Check[X][Y] == 0)
                {
                    Q.push({X, Y});
                    Check[X][Y] = 1;
                    
                    Islands++;
                    
                    while(Q.empty() == false)
                    {
                        Temp = Q.front();
                        Q.pop();
                        
                        for(int I = Temp[0]-1; I < Temp[0]+2; I++)
                        {
                            if(I > -1 && I < M)
                            {
                                for(int J = Temp[1]-1; J < Temp[1]+2; J++)
                                {
                                    if(J > -1 && J < N)
                                    {
                                        if(Grid[I][J] == 'L' && Check[I][J] == 0)
                                        {
                                            Check[I][J] = 1;
                                            Q.push({I, J});
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        
        return Islands;
    }
};
