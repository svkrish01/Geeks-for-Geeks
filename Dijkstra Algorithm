// Dijkstra Algorithm

class Solution 
{
    public:
        vector<int> dijkstra(int V, vector<vector<int>> &Edges, int S) 
        {
            vector<int> Distance (V, INT_MAX);
            
            vector<vector<pair<int, int>>> Adj (V);
            int Y, Z;
            
            priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> Q;
            
            for(vector<int> Temp : Edges)
            {
                Adj[Temp[0]].push_back({Temp[1], Temp[2]});
                Adj[Temp[1]].push_back({Temp[0], Temp[2]});
            }
            
            Q.push({0, S});
            Distance[S] = 0;
            
            while(Q.empty() == false)
            {
                Y = Q.top().second;
                Z = Q.top().first;
                
                Q.pop();
                
                if(Z > Distance[Y]) continue;
                
                for(pair<int, int> X : Adj[Y])
                {
                    if(Distance[X.first] > Z + X.second)
                    {
                        Distance[X.first] = Z + X.second;
                        Q.push({Distance[X.first], X.first});
                    }
                }
            }
            
            return Distance;
        }
};
